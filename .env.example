# Supabase Postgres — via pooler (hostname db.*.supabase.co sudah tidak resolve).
# Session mode port 5432 (TANPA pgbouncer) untuk `prisma migrate` + dev lokal.
# Production di Render pakai transaction mode port 6543 + ?pgbouncer=true (lihat 2c §3.1).
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
# Clerk — secret HANYA di server, JANGAN pakai prefix VITE_ (lihat 2c §1)
CLERK_SECRET_KEY="sk_test_..."
# Clerk — publishable key untuk frontend Vite
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
# Server Express
PORT=3001
